<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_set_budget.xml - Set Monthly Budget Dialog for TrackWise AI
    
    This dialog appears when user clicks "Set Budget" from the navigation drawer or toolbar.
    It allows users to set their monthly minimum and maximum spending goals.
    
    - Min Goal: The minimum amount user wants to spend (for saving targets)
    - Max Goal: The maximum budget limit (warning when exceeded)
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Dialog Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Monthly Budget"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <!-- ==================== MINIMUM GOAL INPUT ==================== -->
    <!-- User can set a minimum spending target (good for savings goals) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMinGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Minimum Goal (R)"
            android:inputType="numberDecimal"      <!-- Only numbers and decimal point -->
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ==================== MAXIMUM GOAL INPUT ==================== -->
    <!-- User can set a maximum budget limit (trigger warnings when exceeded) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMaxGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Maximum Goal (R)"
            android:inputType="numberDecimal"      <!-- Only numbers and decimal point -->
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
