<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_dashboard.xml - Dashboard Screen for TrackWise AI
    
    This fragment displays:
    - Budget progress card (percentage, amount spent, min/max goals)
    - Period selector button (Today, Week, Month, etc.)
    - List of recent transactions
    
    This is the home screen shown after user logs in.
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background">

    <!-- ==================== BUDGET PROGRESS CARD ==================== -->
    <!-- Shows user's spending progress against monthly budget goals -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"          <!-- Rounded corners -->
        app:cardElevation="2dp"              <!-- Subtle shadow -->
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budget Progress"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <!-- Budget Percentage (Large Text) -->
            <TextView
                android:id="@+id/tvBudgetPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="48sp"              <!-- Large prominent text -->
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="4dp" />

            <!-- Progress Bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBudget"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:indicatorColor="@color/primary"   <!-- Progress color -->
                app:trackColor="#E2E8F0" />           <!-- Background color -->

            <!-- Row: Amount Spent (Left) and Goal Range (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Amount Spent - Left side -->
                <TextView
                    android:id="@+id/tvSpentAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="R 0.00 Spent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <!-- Goal Range - Right side -->
                <TextView
                    android:id="@+id/tvGoalRange"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Min: R0 | Max: R0"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="end" />          <!-- Aligns text to the right -->

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== PERIOD SELECTOR ROW ==================== -->
    <!-- Allows user to filter transactions by date range -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- Section Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recent Transactions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- Select Period Button (Outlined style) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Period"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="20dp"                 <!-- Pill shape -->
            app:strokeColor="@color/primary"        <!-- Border color -->
            app:strokeWidth="1dp"                   <!-- Border thickness -->
            android:textColor="@color/primary" />   <!-- Text color -->

    </LinearLayout>

    <!-- ==================== TRANSACTIONS LIST ==================== -->
    <!-- RecyclerView displays scrollable list of recent expenses -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentExpenses"
        android:layout_width="match_parent"
        android:layout_height="0dp"                 <!-- Takes remaining space -->
        android:layout_weight="1" />                <!-- Expands to fill available space -->

</LinearLayout>
