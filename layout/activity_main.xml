<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml - Main Activity Layout for TrackWise AI
    
    This is the container layout that holds:
    - Login screen (when user is not logged in)
    - Main app content (when user is logged in)
    - Navigation drawer (side menu)
    
    The layout switches between login and app content based on user session state.
-->

<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ============================================================ -->
    <!-- MAIN CONTENT - Contains both Login and App screens          -->
    <!-- ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ==================== LOGIN SCREEN ==================== -->
        <!-- Shown when no user is logged in -->
        <LinearLayout
            android:id="@+id/loginLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center"
            android:background="@color/background"
            android:visibility="visible">

            <!-- App Logo -->
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_logo"
                android:layout_marginBottom="16dp" />

            <!-- App Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TrackWise"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:letterSpacing="0.02" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart budgeting starts here."
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="48dp"
                android:layout_marginTop="8dp" />

            <!-- Username Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Input Field (with show/hide toggle) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:endIconMode="password_toggle"
                android:layout_marginBottom="24dp"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Get Started"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/text_white"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/primary" />

            <!-- Create Account Link -->
            <TextView
                android:id="@+id/tvCreateAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:padding="8dp" />

        </LinearLayout>

        <!-- ==================== MAIN APP CONTENT ==================== -->
        <!-- Shown when user is logged in -->
        <LinearLayout
            android:id="@+id/appContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/background">

            <!-- Top Toolbar with Logo and Title -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/primary"
                app:titleTextColor="@color/text_white"
                app:logo="@drawable/ic_logo"
                app:logoDescription="TrackWise Logo"
                app:title="TrackWise" />

            <!-- Fragment Container - dynamically loads screens -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>

    <!-- ============================================================ -->
    <!-- NAVIGATION DRAWER (Side Menu)                                -->
    <!-- ============================================================ -->
    <!-- Slides in from left edge, contains navigation items -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/navigation_drawer_menu"
        app:headerLayout="@layout/nav_header" />

</androidx.drawerlayout.widget.DrawerLayout>
