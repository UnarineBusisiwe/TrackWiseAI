<?xml version="1.0" encoding="utf-8"?>
<!--
    item_expense.xml - Expense List Item Layout for TrackWise AI
    
    This layout represents a single expense item in the RecyclerView list.
    It appears in:
    - Dashboard (recent transactions)
    - View Expenses screen (filtered list)
    
    Each item shows:
    - Optional photo thumbnail
    - Expense description
    - Date and time
    - Amount spent
-->

<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"          <!-- Rounded corners -->
    app:cardElevation="2dp"              <!-- Subtle shadow -->
    android:layout_margin="8dp">         <!-- Space between items -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- ==================== PHOTO ICON / THUMBNAIL ==================== -->
        <!-- Displays camera icon if photo attached, otherwise placeholder -->
        <ImageView
            android:id="@+id/ivExpensePhoto"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"        <!-- Crops image to fill area -->
            android:background="#E0E0E0"          <!-- Light gray background -->
            android:src="@android:drawable/ic_menu_camera" /> <!-- Default icon -->

        <!-- ==================== TEXT CONTENT (Description & Date/Time) ==================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"              <!-- Takes remaining horizontal space -->
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Expense Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <!-- Date and Time (e.g., "15 May 2026 | 14:30") -->
            <TextView
                android:id="@+id/tvDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date | Time"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- ==================== AMOUNT ==================== -->
        <!-- Shows expense amount in Rands (right-aligned) -->
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R 0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
