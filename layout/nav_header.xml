<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_header.xml - Navigation Drawer Header Layout for TrackWise AI
    
    This layout appears at the top of the navigation drawer (side menu).
    It displays user profile information:
    - Profile picture (circular)
    - Username
    - User email
    
    The header provides a personalized experience and quick access to profile.
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/primary"      <!-- Brand color background -->
    android:gravity="center">

    <!-- ==================== PROFILE PICTURE ==================== -->
    <!-- Circular image view for user avatar -->
    <!-- CircleImageView library creates perfect circle with border -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivProfileImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
       android:src="@drawable/ic_default_profile"     <!-- Default icon until user uploads -->
        app:civ_border_width="2dp"                    <!-- White border thickness -->
        app:civ_border_color="@color/text_white" />   <!-- White border color -->

    <!-- ==================== USERNAME ==================== -->
    <!-- Displays logged-in user's name -->
    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Name"                      <!-- Placeholder text -->
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_white"         <!-- White text on dark background -->
        android:layout_marginTop="12dp" />

    <!-- ==================== USER EMAIL ==================== -->
    <!-- Displays user's email (generated from username) -->
    <TextView
        android:id="@+id/tvUserEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="user@trackwise.com"             <!-- Placeholder email -->
        android:textSize="12sp"
        android:textColor="@color/text_white" />      <!-- White text on dark background -->

</LinearLayout>
