<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_create_account.xml
    Layout file for creating a new user account in TrackWise AI app.
    
    This layout contains:
    - App logo for branding
    - Username input field
    - Password input field (with toggle to show/hide)
    - Confirm password input field (with toggle to show/hide)
    - Create Account button
    - Back to Login link
    
    This dialog appears when user clicks "Create Account" on the login screen.
    
    Author: TrackWise AI Team
    Version: 1.0
-->

<!-- 
    ScrollView - Wraps the entire layout to allow scrolling
    This is CRITICAL because when the keyboard appears, the content
    can scroll up so all fields remain visible to the user.
    Without this, the keyboard would squash the dialog and hide fields.
    
    android:fillViewport="true" - Ensures ScrollView fills the entire screen
    even when content is smaller than the screen height
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"      <!-- Uses color from colors.xml -->
    android:fillViewport="true">                 <!-- Fills the entire viewport -->

    <!-- 
        LinearLayout - Main container for all form fields
        Orientation: Vertical - Stacks elements top to bottom
        gravity: center_horizontal - Centers children horizontally
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"     <!-- Height adjusts to content -->
        android:orientation="vertical"
        android:padding="24dp"                   <!-- 24dp padding on all sides -->
        android:gravity="center_horizontal">     <!-- Centers all children horizontally -->

        <!-- ============================================================ -->
        <!-- APP LOGO SECTION                                              -->
        <!-- ============================================================ -->
        
        <!-- 
            App Logo ImageView
            Displays the TrackWise AI logo for brand recognition
            Makes the dialog look professional and consistent with the app
        -->
        <ImageView
            android:layout_width="80dp"           <!-- 80dp width -->
            android:layout_height="80dp"          <!-- 80dp height (square) -->
            android:src="@drawable/ic_logo"       <!-- Logo image from drawable folder -->
            android:layout_marginBottom="24dp" /> <!-- 24dp space below logo -->

        <!-- ============================================================ -->
        <!-- DIALOG TITLE                                                 -->
        <!-- ============================================================ -->
        
        <!-- 
            Dialog Title TextView
            Shows "Create Account" as the heading
            Uses primary color for brand consistency
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"         <!-- Title text -->
            android:textSize="24sp"               <!-- 24sp font size -->
            android:textStyle="bold"              <!-- Bold text style -->
            android:textColor="@color/primary"    <!-- Primary brand color -->
            android:layout_marginBottom="32dp" /> <!-- 32dp space below title -->

        <!-- ============================================================ -->
        <!-- USERNAME INPUT FIELD                                          -->
        <!-- ============================================================ -->
        
        <!-- 
            TextInputLayout - Material Design wrapper for EditText
            Provides floating hint, error handling, and animations
            style: OutlinedBox gives a bordered box style with floating label
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">   <!-- 16dp space below field -->

            <!-- 
                TextInputEditText - Input field for username
                android:hint - Shows "Username" as placeholder text
            -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewUsername"   <!-- Unique ID to reference in code -->
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username" />         <!-- Hint shown when field is empty -->
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============================================================ -->
        <!-- PASSWORD INPUT FIELD                                          -->
        <!-- ============================================================ -->
        
        <!-- 
            TextInputLayout with password toggle
            app:endIconMode="password_toggle" - Adds an eye icon to show/hide password
            This improves user experience by letting users see what they typed
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp"    <!-- 16dp space below field -->
            app:endIconMode="password_toggle">    <!-- Eye icon to toggle password visibility -->

            <!-- 
                TextInputEditText - Input field for password
                android:inputType="textPassword" - Hides characters with dots/bullets
            -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPassword"   <!-- Unique ID for password field -->
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"           <!-- Hint: Password -->
                android:inputType="textPassword" /> <!-- Masks input with dots -->
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============================================================ -->
        <!-- CONFIRM PASSWORD INPUT FIELD                                  -->
        <!-- ============================================================ -->
        
        <!-- 
            TextInputLayout for password confirmation
            Also has password toggle to show/hide confirm password
            Extra bottom margin (32dp) creates more space before the button
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="32dp"    <!-- 32dp space below field (extra space) -->
            app:endIconMode="password_toggle">    <!-- Eye icon to toggle visibility -->

            <!-- 
                TextInputEditText - Input field for confirming password
                User must type their password again to ensure no typos
            -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword" <!-- Unique ID for confirm field -->
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm Password"   <!-- Hint: Confirm Password -->
                android:inputType="textPassword" /> <!-- Masks input with dots -->
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============================================================ -->
        <!-- CREATE ACCOUNT BUTTON                                         -->
        <!-- ============================================================ -->
        
        <!-- 
            Primary Action Button - Creates the new account
            MaterialButton with rounded corners (28dp radius creates a pill shape)
            Fixed height of 56dp follows Material Design guidelines for touch targets
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateAccount"    <!-- Unique ID for create button -->
            android:layout_width="match_parent"
            android:layout_height="56dp"          <!-- Material Design recommended height -->
            android:text="Create Account"         <!-- Button text -->
            app:cornerRadius="28dp" />            <!-- Rounded corners (pill shape) -->

        <!-- ============================================================ -->
        <!-- BACK TO LOGIN LINK                                            -->
        <!-- ============================================================ -->
        
        <!-- 
            Secondary Action - Returns to login screen
            Styled as a text link rather than a button for hierarchy
            User can tap this if they already have an account
        -->
        <TextView
            android:id="@+id/tvBackToLogin"      <!-- Unique ID for back link -->
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Login"          <!-- Link text -->
            android:textColor="@color/primary"    <!-- Primary brand color -->
            android:layout_marginTop="16dp"       <!-- 16dp space above link -->
            android:padding="8dp" />              <!-- 8dp padding for better touch area -->

    </LinearLayout>

</ScrollView>
