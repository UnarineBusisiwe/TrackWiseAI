<?xml version="1.0" encoding="utf-8"?>
<!--
    navigation_drawer_menu.xml - Complete Navigation Drawer Menu for TrackWise AI
    
    This menu appears in the side navigation drawer (hamburger menu).
    It provides access to all app features:
    - Main navigation (Dashboard, Add Expense, View Expenses)
    - User settings (Profile, Budget)
    - Display settings (Light/Dark Mode)
    - App info (About)
    - Account management (Logout)
-->

<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ==================== MAIN NAVIGATION GROUP ==================== -->
    <!-- Single selection group - only one item can be selected at a time -->
    <group android:checkableBehavior="single">
        
        <!-- Dashboard - Home screen -->
        <item
            android:id="@+id/nav_dashboard"
            android:icon="@android:drawable/ic_menu_today"
            android:title="Dashboard" />

        <!-- Add Expense - Create new expense entry -->
        <item
            android:id="@+id/nav_add_expense"
            android:icon="@android:drawable/ic_menu_add"
            android:title="Add Expense" />

        <!-- View Expenses - List and filter expenses -->
        <item
            android:id="@+id/nav_view_expenses"
            android:icon="@android:drawable/ic_menu_view"
            android:title="View Expenses" />

        <!-- My Profile - Edit user profile and photo -->
        <item
            android:id="@+id/nav_profile"
            android:icon="@android:drawable/ic_menu_edit"
            android:title="My Profile" />

        <!-- Set Budget - Configure monthly spending goals -->
        <item
            android:id="@+id/nav_set_budget"
            android:icon="@android:drawable/ic_menu_edit"
            android:title="Set Budget" />
    </group>

    <!-- ==================== DISPLAY SETTINGS SECTION ==================== -->
    <!-- Submenu for theme preferences -->
    <item android:title="Display Settings">
        <menu>
            <!-- Light Mode - Switches app to light theme -->
            <item
                android:id="@+id/nav_light_mode"
                android:icon="@android:drawable/ic_menu_day"
                android:title="Light Mode" />

            <!-- Dark Mode - Switches app to dark theme (eye-friendly) -->
            <item
                android:id="@+id/nav_dark_mode"
                android:icon="@android:drawable/ic_menu_month"
                android:title="Dark Mode" />
        </menu>
    </item>

    <!-- ==================== ABOUT ==================== -->
    <!-- App information, version, privacy policy -->
    <item
        android:id="@+id/nav_about"
        android:icon="@android:drawable/ic_menu_info_details"
        android:title="About" />

    <!-- ==================== LOGOUT ==================== -->
    <!-- Ends user session and returns to login screen -->
    <item
        android:id="@+id/nav_logout"
        android:icon="@android:drawable/ic_menu_close_clear_cancel"
        android:title="Logout" />

</menu>
